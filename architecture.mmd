flowchart TD
    %% Define Styles
    classDef client fill:#e2e8f0,stroke:#64748b,stroke-width:2px;
    classDef backend fill:#fef2f2,stroke:#e11d48,stroke-width:2px;
    classDef database fill:#ecfdf5,stroke:#10b981,stroke-width:2px;
    classDef core fill:#eff6ff,stroke:#3b82f6,stroke-width:2px;
    
    User([End User Browser]):::client
    
    subgraph Web App Frontend
        Templates["Jinja2 HTML Templates (templates/)"]:::client
        Static["CSS & JS Assets (static/)"]:::client
    end
    
    subgraph Flask Backend Server
        Run["run.py (Entry Point)"]:::core
        Init["__init__.py (App Setup)"]:::core
        
        Routes["routes.py (Controller logic)"]:::backend
        Forms["forms.py (Validation & WTForms)"]:::backend
        Models["models.py (Data Models)"]:::backend
        Config["config.py (Environment config)"]:::backend
    end
    
    DB[("SQLite Database (site.db)")]:::database
    
    %% Interactions
    User -- HTTP GET/POST Requests --> Run
    Run --> Init
    Init --> Config
    Init --> Routes
    
    Routes -- Interacts with Data --> Models
    Routes -- Validates Form Submissions --> Forms
    Routes -- Renders UI --> Templates
    Templates -- Loads Scripts/Styles --> Static
    
    Models <== Object Relational Mapping ==> DB
    Templates -- Sent as HTTP Response --> User
